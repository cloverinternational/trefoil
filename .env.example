# PostgreSQL is required for the production backend.
DATABASE_URL=postgres://trefoil:trefoil@127.0.0.1:5432/trefoil
DATABASE_MAX_CONNECTIONS=16
ADMIN_KEY=replace-me
# Required to read or write OAuth credentials. Generate with: openssl rand -hex 32
TREFOIL_CREDENTIAL_KEY=replace-with-64-hex-characters
# LAN HTTP frontend port. PostgreSQL is intentionally not published.
TREFOIL_PORT=8080
TREFOIL_PUBLIC_URL=http://127.0.0.1:8080
POSTGRES_DB=trefoil
POSTGRES_USER=trefoil
POSTGRES_PASSWORD=replace-with-a-long-random-password
