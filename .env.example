# Trefoil environment. Copy to .env, fill in every required value, and keep the
# file private (chmod 600 .env). Never commit .env.
#
# Generate secrets with openssl, for example:
#   openssl rand -hex 32   # 64 hex characters
#
# docker compose refuses to start while a required value below is empty.

# --- Required ----------------------------------------------------------------

# Admin key for the management API (/v0/management/*) and the admin UI login.
# Sent as the x-admin-key header. Use a long random value: openssl rand -hex 32
ADMIN_KEY=

# AES-256-GCM key for OAuth access/refresh tokens stored in PostgreSQL.
# Exactly 64 hex characters: openssl rand -hex 32
# Losing or changing it makes stored OAuth credentials unreadable.
TREFOIL_CREDENTIAL_KEY=

# PostgreSQL password used by the bundled postgres service and the backend.
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Strongly recommended ----------------------------------------------------

# Encrypts provider API keys, API key secrets and other sensitive settings at
# rest (Plexus-compatible "enc:v1:" envelope). Either 64 hex characters (used
# directly) or any other string (derived with scrypt). Empty disables
# encryption and the backend logs a warning. Once set, keep it: encrypted rows
# cannot be read without it. openssl rand -hex 32
ENCRYPTION_KEY=

# --- Optional ----------------------------------------------------------------

# Database name and user for the bundled postgres service.
POSTGRES_DB=trefoil
POSTGRES_USER=trefoil

# Maximum PostgreSQL pool size for the backend.
DATABASE_MAX_CONNECTIONS=16

# Host interface and port where the web UI and API are published (HTTP).
# Use 127.0.0.1 to accept local connections only. PostgreSQL is never published.
TREFOIL_BIND_ADDRESS=0.0.0.0
TREFOIL_PORT=8080

# Startup log level: error, warn, info, debug, verbose or silly.
LOG_LEVEL=info

# DATABASE_URL is assembled by docker-compose.yml from the POSTGRES_* values.
# Set it yourself only when running the backend outside Compose, e.g.:
# DATABASE_URL=postgres://trefoil:<password>@127.0.0.1:5432/trefoil
