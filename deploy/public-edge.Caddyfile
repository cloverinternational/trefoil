# Public edge for trefoil.
#
# Hoja Cloud tenants must reach the inference API; the admin UI and the whole
# /v0/management surface must not be public. This edge therefore proxies exactly
# /v1/* and /healthz and answers 404 for everything else. The admin UI stays on the
# tailnet via `tailscale serve`.
trefoil.hoja.work {
	encode zstd gzip

	# Streaming: hand SSE through without buffering.
	@inference path /v1/* /healthz
	handle @inference {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else - /v0/management/*, /ui/*, /assets/*, / - is not public.
	handle {
		respond "not found" 404
	}

	log {
		output file /var/log/trefoil-edge/access.log
	}
}
